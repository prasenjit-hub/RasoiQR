# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_anon_key

# Example:
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo mode: set to "true" to enable hardcoded demo credentials and
# in-memory mock data. MUST be "false" (or omitted) in production.
# See src/services/restaurantService.ts and src/pages/public/LoginPage.tsx
# for the gated code paths.
VITE_DEMO_MODE=false

# Cloudinary Setup for Image Uploads
VITE_CLOUDINARY_CLOUD_NAME=dcnkg4pob

# Cloudflare Turnstile — bot protection on the public order form. OPTIONAL.
#
# Blank (the default) keeps ordering exactly as it is today: the checkout calls
# customer_create_order directly and nothing changes.
#
# Filling it in is a go-live switch, and the order matters. Do it ONLY after:
#   1. the `submit-order` edge function is deployed, and
#   2. that function's TURNSTILE_SECRET_KEY secret is set
# because from this moment the checkout stops calling the RPC itself and every
# order goes through the function. See supabase/functions/submit-order/index.ts
VITE_TURNSTILE_SITE_KEY=
