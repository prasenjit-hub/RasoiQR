# Supabase Configuration
# Get these values from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_anon_key

# Example:
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo mode: set to "true" to enable hardcoded demo credentials and
# in-memory mock data. MUST be "false" (or omitted) in production.
# See src/services/restaurantService.ts and src/pages/public/LoginPage.tsx
# for the gated code paths.
VITE_DEMO_MODE=false
