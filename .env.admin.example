# Server-side Supabase credentials for admin bootstrap only.
# Copy this file to `.env.admin`, fill in the real values, and restrict
# access permissions. The script `database/scripts/create-admin.mjs`
# reads from `.env.admin` at the project root.
#
#   On Linux / macOS:
#     cp .env.admin.example .env.admin
#     chmod 600 .env.admin
#     # edit .env.admin
#
#   On Windows:
#     copy .env.admin.example .env.admin
#     # edit .env.admin
#     # then right-click -> Properties -> Security -> restrict to your user only
#
# Find both values in:
#   Supabase Dashboard -> Settings -> API
#
# WARNING: The service_role key bypasses Row Level Security. It must
# never be committed, never bundled into the client, and never logged.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key
